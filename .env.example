# 自由简历 — 部署敏感配置（占位，复制成 .env 后填值）
# .env 已在 .gitignore，永远不会入 git。
#
# 注意：本文件**没有真实凭证**。
# 真实凭证的 `deploy.sh` 历史 commit 中也已存在（b04afc2 之前），如下游需要彻底清：
#   1. 修改真实服务器密码
#   2. 视情况 git filter-repo 清历史 + force-push（仅个人项目，且需通知所有协作者）

# 服务器 SSH 登录凭据
SERVER_IP=82.156.105.87
SERVER_USER=root
SERVER_PASS=replace-me-with-real-password
SERVER_PATH=/www/wwwroot/resume.toolsetlink.com

# 构建产物目录（Next.js 16）：
#   - 默认 server bundle: .next/（需要 Node 服务器运行 next start）
#   - 静态导出（next.config.ts 设 output: 'export'）: out/
# 当前 deploy.sh 默认按 server bundle 处理（输出目录按 NEXT_DEPLOY_MODE 切换）
NEXT_DEPLOY_MODE=server
